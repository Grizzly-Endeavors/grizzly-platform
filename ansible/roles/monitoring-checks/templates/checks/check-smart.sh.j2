#!/usr/bin/env bash
# Managed by Ansible — monitoring-checks role
# Check SMART health, temperatures, and reallocated sectors for all drives
set -euo pipefail

source "{{ monitoring_lib_dir }}/lib/alert.sh"
init_metrics "check_smart"

CHECK="check-smart"

# No SMART tooling (e.g. virtualized VPS disks where smartmontools isn't
# installed) — there is nothing to check. Without this guard, `smartctl -H`
# below fails to run, the PASSED/OK grep matches nothing, and every disk is
# reported unhealthy (false-critical SmartUnhealthy). Emit a clean metric set
# so any prior `monitoring_smart_healthy 0` series goes stale and exit.
if ! command -v smartctl >/dev/null 2>&1; then
    write_metric "monitoring_smart_check_time" "$(date +%s)" "Timestamp of last SMART check" "gauge"
    flush_metrics
    exit 0
fi

REALLOCATED_WARN={{ monitoring_smart_reallocated_warn }}
TEMP_WARN={{ monitoring_temp_warn_drive }}
TEMP_CRIT={{ monitoring_temp_crit_drive }}

write_metric "monitoring_smart_check_time" "$(date +%s)" "Timestamp of last SMART check" "gauge"

# Kernel names (sda, nvme0n1) are assigned in enumeration order and move
# between boots, so a series keyed by them follows the letter rather than the
# disk. Map each whole disk to a stable by-id name. Those symlinks are
# relative (ata-XXX -> ../../sda); readlink -f resolves them. Prefer wwn, then
# nvme-eui, then ata, and skip partition links. Disks with none of those fall
# back to the SMART serial inside the loop.
BY_ID_DIR="/dev/disk/by-id"
declare -A DEV_STABLE_ID=()
index_stable_disk_ids() {
    local prefix link target base
    local -a links
    for prefix in 'wwn-*' 'nvme-eui.*' 'ata-*'; do
        links=()
        for link in "${BY_ID_DIR}"/${prefix}; do
            [[ -e "$link" ]] || continue
            base=$(basename "$link")
            [[ "$base" == *-part* ]] && continue
            links+=("$link")
        done
        (( ${#links[@]} )) || continue
        while IFS= read -r link; do
            target=$(readlink -f "$link" 2>/dev/null || true)
            [[ -n "$target" ]] || continue
            if [[ -z "${DEV_STABLE_ID[$target]:-}" ]]; then
                DEV_STABLE_ID["$target"]=$(basename "$link")
            fi
        done < <(printf '%s\n' "${links[@]}" | LC_ALL=C sort)
    done
}
index_stable_disk_ids

# Find all block devices that are physical disks (not partitions, not loop)
for dev in /dev/sd? /dev/nvme?n?; do
    [[ -b "$dev" ]] || continue

    device_name=$(basename "$dev")
    dev_real=$(readlink -f "$dev")
    stable_id=${DEV_STABLE_ID[$dev_real]:-}
    if [[ -z "$stable_id" ]]; then
        serial=$(smartctl -i "$dev" 2>/dev/null | awk -F: '/^Serial Number:/{gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit}' || true)
        serial=${serial//[^A-Za-z0-9._:+-]/_}
        if [[ -n "$serial" ]]; then
            stable_id="serial_${serial}"
        else
            stable_id="$device_name"
        fi
    fi
    stable_id=${stable_id//[^A-Za-z0-9._:+-]/_}
    labels="device=\"${stable_id}\",kname=\"${device_name}\""

    # Overall SMART health. Use smartctl's exit status rather than grepping
    # the verdict text: bit 3 (value 8) is set only when the drive itself
    # reports FAILING, while bits 0-2 mean smartctl couldn't get an answer
    # (device busy, transport hiccup, identify timeout). A momentary
    # no-answer is not a failing drive, so it gets one retry and is then
    # logged as a check warning — not raised as a critical health alert.
    verdict=""
    for _ in 1 2; do
        rc=0
        smartctl -H "$dev" >/dev/null 2>&1 || rc=$?
        if (( rc & 8 )); then
            verdict="failed"; break
        elif (( (rc & 7) == 0 )); then
            verdict="passed"; break
        fi
        sleep 3
    done

    case "$verdict" in
        failed)
            alert "critical" "$CHECK" "health_${stable_id}" "SMART health check FAILED for ${stable_id} (${dev})"
            write_metric_labeled "monitoring_smart_healthy" "$labels" "0"
            ;;
        passed)
            clear_alert "$CHECK" "health_${stable_id}"
            write_metric_labeled "monitoring_smart_healthy" "$labels" "1"
            ;;
        *)
            logger -t "monitoring" -p "user.warning" "[WARNING] ${CHECK}: smartctl could not read SMART status from ${dev} (exit ${rc}); health left unchanged this cycle"
            ;;
    esac

    # Temperature (SATA drives use attribute 194, NVMe uses smartctl -A)
    temp=""
    if [[ "$dev" == /dev/nvme* ]]; then
        temp=$(smartctl -A "$dev" 2>/dev/null | awk '/^Temperature:/{print $2}' || true)
    else
        temp=$(smartctl -A "$dev" 2>/dev/null | awk '/^194/{print $10}' || true)
    fi

    if [[ -n "$temp" && "$temp" =~ ^[0-9]+$ ]]; then
        write_metric_labeled "monitoring_smart_temperature_celsius" "$labels" "$temp"
        if (( temp >= TEMP_CRIT )); then
            alert "critical" "$CHECK" "temp_${stable_id}" "Drive ${stable_id} (${dev}) temperature CRITICAL: ${temp}°C (threshold: ${TEMP_CRIT}°C)"
        elif (( temp >= TEMP_WARN )); then
            alert "warning" "$CHECK" "temp_${stable_id}" "Drive ${stable_id} (${dev}) temperature WARNING: ${temp}°C (threshold: ${TEMP_WARN}°C)"
        else
            clear_alert "$CHECK" "temp_${stable_id}"
        fi
    fi

    # Reallocated sectors (SATA attribute 5)
    if [[ "$dev" == /dev/sd* ]]; then
        reallocated=$(smartctl -A "$dev" 2>/dev/null | awk '/^  5/{print $10}' || true)
        if [[ -n "$reallocated" && "$reallocated" =~ ^[0-9]+$ ]]; then
            write_metric_labeled "monitoring_smart_reallocated_sectors" "$labels" "$reallocated"
            if (( reallocated >= REALLOCATED_WARN )); then
                alert "warning" "$CHECK" "reallocated_${stable_id}" "Drive ${stable_id} (${dev}) has ${reallocated} reallocated sectors (threshold: ${REALLOCATED_WARN})"
            else
                clear_alert "$CHECK" "reallocated_${stable_id}"
            fi
        fi
    fi
done

flush_metrics
